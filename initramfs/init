#!/bin/sh
# ABINSTEIN OS initramfs init
# Minimal early boot sequence for QEMU ARM64 environment

set -eu

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

log() { printf '%b[%s]%b %s\n' "${GREEN}" "INIT" "${NC}" "$*"; }
warn() { printf '%b[%s]%b %s\n' "${YELLOW}" "WARN" "${NC}" "$*"; }
info() { printf '%b[%s]%b %s\n' "${BLUE}" "INFO" "${NC}" "$*"; }

mount_if_needed() {
    local type="$1"
    local src="$2"
    local target="$3"
    local opts="${4:-}"

    if mountpoint -q "${target}"; then
        info "${target} already mounted"
        return 0
    fi

    mkdir -p "${target}"
    if [ -n "${opts}" ]; then
        mount -t "${type}" -o "${opts}" "${src}" "${target}" || warn "Could not mount ${target}"
    else
        mount -t "${type}" "${src}" "${target}" || warn "Could not mount ${target}"
    fi
}

main() {
    clear
    log "ABINSTEIN OS Phase 1 boot sequence"
    log "Kernel: $(uname -r)"
    log "Machine: $(uname -m)"

    mount_if_needed proc proc /proc nosuid,nodev,noexec
    mount_if_needed sysfs sysfs /sys nosuid,nodev,noexec
    mount_if_needed devtmpfs devtmpfs /dev nosuid,size=10m,nr_inodes=248418,mode=755
    mkdir -p /dev/pts /run /tmp
    mount_if_needed devpts devpts /dev/pts nosuid,noexec
    mount_if_needed tmpfs tmpfs /run nosuid,nodev,mode=755

    [ -e /dev/console ] || mknod /dev/console c 5 1
    [ -e /dev/null ] || { mknod /dev/null c 1 3; chmod 666 /dev/null; }
    [ -e /dev/zero ] || { mknod /dev/zero c 1 5; chmod 666 /dev/zero; }
    [ -e /dev/random ] || { mknod /dev/random c 1 8; chmod 644 /dev/random; }
    [ -e /dev/urandom ] || { mknod /dev/urandom c 1 9; chmod 644 /dev/urandom; }

    export PATH=/bin:/sbin:/usr/bin:/usr/sbin:/usr/local/bin:/usr/local/sbin
    export HOME=/root
    export TERM=linux

    log "Launching early system init"
    if [ -x /etc/init.d/rcS ]; then
        /etc/init.d/rcS
    else
        warn "No /etc/init.d/rcS found; starting shell"
    fi

    exec /bin/sh
}

main "$@"
